# ==============================================================================
# Ballast Environment Configuration Template
# Copy this file to .env and populate the required keys for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Cache
# ------------------------------------------------------------------------------
# PostgreSQL connection string with pgvector extension enabled
DATABASE_URL="postgresql://ballast:ballast_dev_password@localhost:5438/ballast_dev"

# Redis connection string for BullMQ background job processing
REDIS_URL="redis://localhost:6388"

# 256-bit AES master key seed for encrypting OAuth tokens at rest in PostgreSQL
BALLAST_ENCRYPTION_KEY="replace_with_a_secure_random_32_byte_secret_key"
SESSION_SECRET="replace_with_a_secure_session_signing_secret"

# App base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. LLM Providers (Configure at least one for live brief drafting and critic)
# ------------------------------------------------------------------------------
# Google Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=""

# Mistral API key: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=""

# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Embedding Provider (Phase C)
# ------------------------------------------------------------------------------
# Preferred embedding provider: "gemini" | "mistral" | "local"
EMBEDDING_PROVIDER="gemini"

# ------------------------------------------------------------------------------
# 4. Google Connectors (Gmail, Google Calendar, Google Drive)
# Create credentials in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/connectors/gmail/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/connectors/gmail/callback"

# ------------------------------------------------------------------------------
# 5. GitHub Connector
# Register a GitHub OAuth App: https://github.com/settings/developers
# Authorized callback URL: http://localhost:3000/api/connectors/github/callback
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/api/connectors/github/callback"

# ------------------------------------------------------------------------------
# 6. Slack Connector
# Create a Slack App: https://api.slack.com/apps
# Redirect URL: http://localhost:3000/api/connectors/slack/callback
# ------------------------------------------------------------------------------
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:3000/api/connectors/slack/callback"

# ------------------------------------------------------------------------------
# 7. Notion Connector
# Create a Notion Integration: https://www.notion.so/my-integrations
# Redirect URL: http://localhost:3000/api/connectors/notion/callback
# ------------------------------------------------------------------------------
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
NOTION_REDIRECT_URI="http://localhost:3000/api/connectors/notion/callback"

# ------------------------------------------------------------------------------
# 8. Evaluation & Testing Mode
# When "true", offline sample fixtures are served for CI and local eval runner.
# Set to "false" for live production runs with real APIs.
# ------------------------------------------------------------------------------
EVAL_USE_MOCK="false"
